70]" /><node index="1" text="1. Conducción Segura y No Manipulación" resource-id="" class="android.widget.TextView" package="com.rutabikersync.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,610][569,658]" /><node index="2" text="La app está diseñada con Modo Guantes (botones ≥72 dp) y voz sintética. Queda terminantemente prohibido manipular la pantalla o escribir mientras la motocicleta se encuentra en movimiento. El teléfono debe usarse en soporte seguro o comunicarse vía intercomunicador Bluetooth." resource-id="" class="android.widget.TextView" package="com.rutabikersync.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,662][634,842]" /><node index="3" text="2. Voz Efímera y No Grabación (R13.1)" resource-id="" class="android.widget.TextView" package="com.rutabikersync.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,866][540,914]" /><node index="4" text="Los clips de audio Push-To-Talk viajan de forma efímera en la malla para alertas operativas (baches, frenadas, cruces). No se graban ni se conservan en ningún servidor central. Al concluir la rodada, se purgan de memoria." resource-id="" class="android.widget.TextView" package="com.rutabikersync.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,918][634,1068]" /><node index="5" text="3. Silenciado Local Inmediato (R13.3)" resource-id="" class="android.widget.TextView" package="com.rutabikersync.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,1092][529,1140]" /><node index="6" text="Cualquier rider puede silenciar localmente al instante a un compañero si considera su tono ofensivo o innecesario, sin interrumpir la recepción del resto del grupo." resource-id="" class="android.widget.TextView" package="com.rutabikersync.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,1144][634,1241]" /></node><node index="6" text="" resource-id="" class="android.view.View" package="com.rutabikersync.app" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,1297][662,1393]"><node index="0" text="Entendido" resource-id="" class="android.widget.TextView" package="com.rutabikersync.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[304,1325][416,1365]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.rutabikersync.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,1305][662,1385]" /></node></node></node></node></node></node></node></hierarchy>