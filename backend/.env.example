NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL 16 (SOLO DESARROLLO LOCAL — nunca reutilizar estas credenciales fuera de local):
# - Puerto 5432: contenedor de `docker compose -f infra/docker-compose.yml up -d` (127.0.0.1:5432)
# - Puerto 5433: servicio nativo PostgreSQL 16 en WSL2 Ubuntu cuando Windows ocupa el puerto 5432
DATABASE_URL=postgres://rbs:rbs_dev_password@localhost:5432/rbs
PG_TEST_URL=postgres://rbs:rbs_dev_password@localhost:5433/rbs_test

# Proxy inverso y autenticación (D35 / D40)
# Activar TRUST_PROXY=true en producción detrás de balanceador / reverse proxy para que request.ip respete X-Forwarded-For
TRUST_PROXY=false
AUTH_TOKEN_ACTIVE_KID=k1
AUTH_TOKEN_SECRET=rbs-dev-hmac-secret-change-in-prod-32b
# Llavero opcional JSON para rotación sin corte: {"k1":"old-secret","k2":"new-secret"}
AUTH_TOKEN_KEYS_JSON=
# Límite de derivaciones scrypt (128 MiB c/u) concurrentes
MAX_CONCURRENT_SCRYPT_HASHES=4

# Clave de firma de credenciales offline (Ed25519, base64). En producción: KMS, nunca en archivo.
CREDENTIAL_SIGNING_KEY_ID=dev-1
CREDENTIAL_SIGNING_PRIVATE_KEY=

# Google Play Developer API (cuenta de servicio) y RTDN
GOOGLE_APPLICATION_CREDENTIALS=./signing-keys/play-service-account.json
PLAY_PACKAGE_NAME=com.rutabikersync.app
PLAY_PUBSUB_AUDIENCE=

# Credenciales: vigencia en días y gracia de pago en días (RULES R7.3)
CREDENTIAL_TTL_DAYS=7
PAYMENT_GRACE_DAYS=3
